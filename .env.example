# Copy to .env and fill in. NEVER commit or paste this file anywhere.
SNOW_URL=https://dev195910.service-now.com
SNOW_USER=fury_integration
SNOW_PASSWORD=
APPROVAL_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APPROVER_IDS=U0CAZH32V2T
AWS_REGION=ap-south-2
AWS_INSTANCE_ID=i-00654e3403673c840

# Mix real and fake pieces (default real). --demo forces all fake.
FURY_SNOW=real
FURY_TARGET=real
FURY_CHAT=real

# Optional durable state (SQLite). Unset = in-memory only, as before.
# FURY_DB=fury.db
# Chat can open incidents only in full mode (default: readonly)
# FURY_CHAT_MODE=readonly

# Per-workflow limits (defaults shown). A workflow that exceeds them stops and escalates to a human.
# FURY_MAX_WORKFLOW_HOPS=40
# FURY_MAX_WORKFLOW_SECONDS=1800

# Operations: tamper-evident audit log file (JSON lines, hash-chained). Unset = in memory only.
# FURY_AUDIT_LOG=audit.jsonl
# Delete stored runs/approvals older than N days at startup (0 = keep forever)
# FURY_RETENTION_DAYS=90

# API authentication (REQUIRED when any integration is real). Create tokens with:
#   python -m fury.auth new <name> <viewer|operator|admin>
# then paste the printed entry(ies) here, comma-separated. Only hashes go in this file.
# FURY_API_TOKENS=alice:admin:<sha256hex>,bob:operator:<sha256hex>
# FURY_AUTH=off   # explicit opt-out for a trusted machine (not recommended)
# Governed autonomy: per-action tier override (human is the default for every action; restricted denies)
# FURY_ACTION_TIERS=clear_temp_files=policy
